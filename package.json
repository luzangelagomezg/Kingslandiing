{
  "name": "kinglanding-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VITE \"node --env-file=kinglanding.env server.mjs --api-only --sql-injection-lab\" \"vite\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
