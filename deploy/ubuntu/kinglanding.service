[Unit]
Description=KINGSLANDING CTF training portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kinglanding
Group=kinglanding
WorkingDirectory=/opt/kinglanding
EnvironmentFile=/etc/kinglanding/kinglanding.env
Environment=HOST=0.0.0.0
Environment=PORT=5000
Environment=KINGSLANDING_DB_PATH=/var/lib/kinglanding/council.sqlite
ExecStart=/usr/bin/node /opt/kinglanding/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=kinglanding
StateDirectoryMode=0750
UMask=0077

[Install]
WantedBy=multi-user.target